{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/bin.ts",
    "build": "bun build src/bin.ts --target bun --outfile dist/bin.mjs",
    "start": "bun dist/bin.mjs",
    "fmt": "cd ../.. && oxfmt apps/server/src",
    "fmt:check": "cd ../.. && oxfmt --check apps/server/src",
    "format": "bun run fmt",
    "lint": "cd ../.. && oxlint --report-unused-disable-directives apps/server/src",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "cd ../.. && drizzle-kit generate",
    "db:migrate": "cd ../.. && drizzle-kit migrate",
    "db:studio": "cd ../.. && drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@effect/platform-bun": "4.0.0-beta.45",
    "@effect/platform-node-shared": "4.0.0-beta.45",
    "@jobseeker/contracts": "workspace:*",
    "@openai/codex-sdk": "^0.135.0",
    "@opencode-ai/sdk": "^1.15.13",
    "@peteqian/browser-agent-sdk": "^0.1.3",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.45",
    "hono": "^4.12.23",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
