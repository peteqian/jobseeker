{
  "name": "@jobseeker/resume-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./document": {
      "types": "./src/document.tsx",
      "import": "./src/document.tsx"
    },
    "./node": {
      "types": "./src/node.tsx",
      "import": "./src/node.tsx"
    },
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "react": "^19.2.7",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.16",
    "typescript": "^5.9.3"
  }
}
